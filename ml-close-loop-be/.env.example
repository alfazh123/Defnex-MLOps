# ── Database ──────────────────────────────────────────────
# Connection string for SQLAlchemy (default: SQLite file)
DATABASE_URL=sqlite:///./data/app.db

# Deployment environment label (used in deployment records)
DEPLOYMENT_ENVIRONMENT=default

# ── Unsloth Studio ───────────────────────────────────────
# Base URL of the Unsloth Studio server
UNSLOTH_STUDIO_URL=http://localhost:8888

# API key for authenticating with Unsloth Studio
UNSLOTH_API_KEY=

# Default model used for training when none is specified
UNSLOTH_DEFAULT_MODEL=unsloth/Qwen3-0.6B

# Comma-separated list of available models
UNSLOTH_MODELS=unsloth/Qwen3-0.6B,unsloth/Qwen3.8-27B,unsloth/Qwen2.5-7B-Instruct

# ── Serving (vLLM) ──────────────────────────────────────
# Which serving backend to use: `mock` (no GPU needed) or `vllm` (real vLLM, see README
# "GPU stack"). Default is `mock` so local dev and tests run without a GPU.
SERVING_BACKEND=mock

# Base URL of the vLLM server (REST runtime API, not the OpenAI-compatible /v1/chat).
# Inside docker (GPU profile) the backend reaches the serving container via `http://serving:8000`.
VLLM_URL=http://localhost:8001

# API key for authenticating with vLLM (optional)
VLLM_API_KEY=

# Per-request timeout in seconds for load/unload adapter calls
VLLM_TIMEOUT_SECONDS=60

# Model + LoRA settings used by the `serving` docker-compose service (GPU profile).
VLLM_MODEL_NAME=unsloth/Qwen3-0.6B
VLLM_SERVED_MODEL_NAME=defnex-model
# Concurrent adapter slots (max_loras). Must be >= 2: deploy intentionally loads the new
# adapter before unloading the superseded one, so two adapters are briefly resident together.
# vLLM defaults to 1, which would evict the live adapter the moment the next one loads.
VLLM_MAX_LORAS=4
VLLM_MAX_LORA_RANK=64

# ── Inference & smoke test (issue #41) ──────────────────
# Whether the smoke test runs during deploy, after the adapter is loaded but before the
# alias/pointer moves. When enabled (default), a deploy whose smoke test fails is aborted:
# the alias stays on the old version and the failure is logged. Disable only for no-GPU
# local dev where generations are mocked.
INFERENCE_SMOKE_ENABLED=true
# Prompt sent to the just-loaded adapter to prove it can generate.
INFERENCE_SMOKE_PROMPT=Return OK.
# Minimum generated-output length for the smoke test to pass (non-empty by default).
INFERENCE_SMOKE_MIN_CHARS=1
# Max tokens for a generation (smoke test + inference endpoint).
INFERENCE_MAX_TOKENS=128

# ── Auth / JWT ───────────────────────────────────────────
# Secret key used to sign JWTs (CHANGE IN PRODUCTION)
JWT_SECRET=dev-secret-change-in-production

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 1440 = 24h)
JWT_EXPIRE_MINUTES=1440

# Refresh token lifetime in minutes (default: 10080 = 7 days)
JWT_REFRESH_EXPIRE_MINUTES=10080

# ── DB Connection Pool ───────────────────────────────────
# Pool size (number of persistent connections, default: 5)
DB_POOL_SIZE=5
# Max overflow connections beyond pool_size (default: 10)
DB_MAX_OVERFLOW=10
# Seconds to wait for a connection before timeout (default: 30)
DB_POOL_TIMEOUT=30
# Seconds before a connection is recycled (default: 1800)
DB_POOL_RECYCLE=1800

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8888,http://localhost:5173

# ── Request Limits ───────────────────────────────────────
# Maximum request body size in bytes (default: 1048576 = 1MB)
MAX_REQUEST_BODY_SIZE=1048576

# ── GPU Training Lock (issue #33) ────────────────────────
# Lock file serializing training across worker processes. Must live on a
# filesystem every worker shares (docker-compose mounts ./data:/app/data);
# flock guarantees exclusivity only among processes opening the same file
# on the same host. (default: data/gpu.lock)
GPU_LOCK_FILE=data/gpu.lock
# Seconds a worker waits for the GPU lock before skipping the poll. On
# timeout the run stays PENDING and is retried on the next poll. (default: 300)
GPU_LOCK_TIMEOUT=300

# ── Training runner (issue #38) ──────────────────────────
# Directory where each trained version is stored in an immutable per-version
# folder (model artifacts + metadata.json). (default: data/artifacts)
ARTIFACT_STORAGE_DIR=data/artifacts

# Interpreter for the SEPARATE training venv (never the app/serving venv).
TRAINING_PYTHON=python3

# Standalone Unsloth training script spawned by the worker runner.
TRAINING_SCRIPT_PATH=app/training/run_training.py

# Seconds before a runaway training subprocess is killed (the run becomes FAILED,
# never stuck RUNNING). 0 disables the timeout. (default: 0)
TRAINING_TIMEOUT_SECONDS=0

# ── Logging ──────────────────────────────────────────────
# Structured log level
LOG_LEVEL=INFO

# Debug mode (verbose logging)
DEBUG=false

# ── Promotion eval gate (issue #43) ─────────────────────
# Each criterion is a boolean toggle (default on). Promotion still requires a
# human trigger; these only gate whether a PROMOTED decision is allowed.
EVAL_GATE_REQUIRE_EVAL_SET_REFERENCE=true
EVAL_GATE_REQUIRE_QUALITATIVE_MAJORITY=true
EVAL_GATE_REQUIRE_NO_GENERAL_REGRESSION=true
EVAL_GATE_REQUIRE_EVAL_LOSS_NOT_WORSE=true
