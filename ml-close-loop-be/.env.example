# ── Database ──────────────────────────────────────────────
# Connection string for SQLAlchemy (default: SQLite file)
DATABASE_URL=sqlite:///./data/app.db

# Deployment environment label (used in deployment records)
DEPLOYMENT_ENVIRONMENT=default

# ── Unsloth Studio ───────────────────────────────────────
# Base URL of the Unsloth Studio server
UNSLOTH_STUDIO_URL=http://localhost:8888

# API key for authenticating with Unsloth Studio
UNSLOTH_API_KEY=

# Default model used for training when none is specified
UNSLOTH_DEFAULT_MODEL=unsloth/Qwen3-0.6B

# Comma-separated list of available models
UNSLOTH_MODELS=unsloth/Qwen3-0.6B,unsloth/Qwen3.8-27B,unsloth/Qwen2.5-7B-Instruct

# ── Auth / JWT ───────────────────────────────────────────
# Secret key used to sign JWTs (CHANGE IN PRODUCTION)
JWT_SECRET=dev-secret-change-in-production

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 1440 = 24h)
JWT_EXPIRE_MINUTES=1440

# ── DB Connection Pool ───────────────────────────────────
# Pool size (number of persistent connections, default: 5)
DB_POOL_SIZE=5
# Max overflow connections beyond pool_size (default: 10)
DB_MAX_OVERFLOW=10
# Seconds to wait for a connection before timeout (default: 30)
DB_POOL_TIMEOUT=30
# Seconds before a connection is recycled (default: 1800)
DB_POOL_RECYCLE=1800

# ── Request Limits ───────────────────────────────────────
# Maximum request body size in bytes (default: 1048576 = 1MB)
MAX_REQUEST_BODY_SIZE=1048576
